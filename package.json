{
  "name": "united-staffing-ai-bench-platform-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check": "cd frontend && npm run check",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
